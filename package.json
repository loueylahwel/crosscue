{
  "name": "crosscue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CROSSCUE: cooperative sighting over a mesh. One device sees a target, every device sees it through the walls.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "relay": "tsx server/relay.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
